# Copy this file to .env.local for local dev (never commit real keys).

# Required — get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_google_gemini_api_key_here

# Optional — enables the narrated Storybook. Free key at https://elevenlabs.io (Profile → API Keys)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Optional — pin a specific ElevenLabs voice; otherwise a good default is auto-selected
# ELEVENLABS_VOICE_ID=
